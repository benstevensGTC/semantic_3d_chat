.DS_Store
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
.venv/
.venv-gemma4/
.cache/
models/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Downloaded models and generated experiment data.
data/oracle/*
data/rendered/*
data/features/*
data/maps/*
data/scene_tokens/*
data/qa/*
data/checkpoints/*
data/runtime_assets/*
data/robot/

# Spatial Lens generated artifacts. The authored room specs under rooms/ are the
# tracked inputs; everything a scan or a fuse produces is large and derived.
data/spatial_lens/*/scans/
data/spatial_lens/*/naming_views/
data/spatial_lens/*/point_cloud.npz
data/spatial_lens/*/*.freegrid.npy
!data/**/.gitkeep

# Isolated Gemma 4 feature/map/checkpoint artifacts remain local. Small
# machine-readable metrics are source artifacts and stay reviewable in Git.
data_gemma4/
data_diverse20/
data_diverse28/
data_diverse52/
data_multi_position/
data_gemma4_multi_position/
# Machine-local pointer to an accepted checkpoint; generated only after promotion.
configs/runtime/primary.json
reports/gemma4/*
!reports/gemma4/metrics/
reports/gemma4/metrics/*
!reports/gemma4/metrics/*.json
!reports/gemma4/final_report.md
!reports/gemma4/figures/
reports/gemma4/figures/*
!reports/gemma4/figures/blender_rover_v14_approach_chair_before.png
!reports/gemma4/figures/blender_rover_v14_approach_chair_complete.png
!reports/gemma4/artifacts/
reports/gemma4/artifacts/*
reports/gemma4_multi_position/

# Generated reports remain local except for the small machine-readable summaries.
# These directories contain nested per-scene/control artifacts, so ignore them
# recursively rather than only matching files immediately below each directory.
reports/figures/**
reports/examples/**
reports/predictions/**

*.blend
*.blend1
*.exr
*.npy
*.npz
*.pt
*.safetensors
!reports/gemma4/artifacts/v26_dense_alignment_bridge.safetensors
uv.toml
